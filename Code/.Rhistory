for (f in tex) {
raw <- readLines(f, warn = FALSE)
bad <- grep("(?<!\\\\)_", raw, perl = TRUE, value = TRUE)
if (length(bad)) cat("\n", basename(f), "\n", paste(" ", bad, collapse = "\n"), "\n")
}
for (f in tex) {
raw <- readLines(f, warn = FALSE)
i <- grep("\\\\toprule", raw)
if (length(i)) cat(sprintf("%-38s %s\n", basename(f), trimws(raw[i + 1])))
}
tex <- list.files(table_dir, pattern = "\\.tex$", full.names = TRUE)
for (f in tex) {
raw <- readLines(f, warn = FALSE)
bad <- grep("(?<!\\\\)_", raw, perl = TRUE, value = TRUE)
if (length(bad)) cat("\n", basename(f), "\n", paste(" ", bad, collapse = "\n"), "\n")
}
for (f in tex) {
raw <- readLines(f, warn = FALSE)
i <- grep("\\\\toprule", raw)
if (length(i)) cat(sprintf("%-38s %s\n", basename(f), trimws(raw[i + 1])))
}
